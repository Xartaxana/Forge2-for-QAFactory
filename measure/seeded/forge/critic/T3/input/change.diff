     if row["unit"] == "bytes":
         return sum(os.path.getsize(os.path.join(root, f)) for f in files)
     if row["unit"] == "nonblank_lines":
         return sum(nonblank(root, f) for f in files)
     return sum(count_rows(root, f) for f in files)
