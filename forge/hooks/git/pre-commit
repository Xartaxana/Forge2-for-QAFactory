#!/usr/bin/env python
# card: C1-5
"""pre-commit (cards C1-5, B8, B9): refuses a commit whose staged paths or index blobs match a row of the one table.

Judges the repository git runs it in. Crash, git absent or an unusable table -> refuse (an irreversible act fails closed).
The matched value is never printed; the refusal is journaled into logs/journal/git-hooks.jsonl.
"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
import secret_scan as ss  # noqa: E402
from hio import io as HIO  # noqa: E402

DOORS = {"found": "a staged secret leaves the commit; patterns change only by a reviewed commit of secret-patterns.yaml",
         "table": ss.DOOR, "git": "git must run to judge the commit; fix git, then commit"}


def body(_v, _n):
    root = None
    try:
        root = ss.toplevel()
        found = ss.scan(root, ss.load_table(root), [("staged", p, s) for p, s in ss.staged(root)])
    except ss.Cannot as exc:
        return HIO.refuse_git(root, "pre-commit", str(exc), DOORS["table" if ss.TABLE in str(exc) else "git"])
    return HIO.refuse_git(root, "pre-commit", "\n".join(found), DOORS["found"]) if found else 0


if __name__ == "__main__":
    sys.exit(HIO.guard(body, 1, "none"))
